{
  "manifest_version": 3,
  "name": "Image Description",
  "version": "0.1.0",
  "description": "Describe an explicitly pasted image for blind and visually impaired people.",
  "homepage_url": "https://github.com/isotopp/image-desc",
  "developer": {
    "name": "Kris Köhntopp",
    "url": "https://github.com/isotopp/image-desc"
  },
  "icons": {
    "32": "icons/image-description-32.png",
    "48": "icons/image-description-48.png",
    "64": "icons/image-description-64.png",
    "96": "icons/image-description-96.png",
    "128": "icons/image-description-128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*",
    "https://api.openai.com/*"
  ],
  "optional_permissions": ["activeTab", "scripting", "https://*/*"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Open Image Description",
    "default_icon": {
      "16": "icons/image-description-16.png",
      "32": "icons/image-description-32.png"
    }
  },
  "sidebar_action": {
    "default_title": "Image Description",
    "default_panel": "sidebar/sidebar.html",
    "open_at_install": false
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kris-imagedescription@koehntopp.de",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "personalCommunications",
          "authenticationInfo"
        ]
      }
    }
  }
}
