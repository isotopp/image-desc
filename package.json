{
  "name": "image-description-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "test": "vitest run",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && web-ext build --source-dir build --artifacts-dir web-ext-artifacts --overwrite-dest",
    "source-package": "bash scripts/package-source.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "web-ext": "^10.6.0"
  }
}
